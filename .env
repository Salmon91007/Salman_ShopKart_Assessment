PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopkart
DB_USER=root
DB_PASSWORD=Salmon@123
DB_CONNECTION_TIMEOUT_MS=10000

# CI Testcontainers may set DATABASE_URL instead of the separate DB_* values.
# DATABASE_URL=mysql://user:encoded-password@host:3306/shopkart

# Use unique training-only values. Never commit the populated .env file.
SHOPKART_TOKEN_SECRET=12345678901234567890123456789012
SHOPKART_ALICE_PASSWORD=AlicePassword@123  
SHOPKART_BOB_PASSWORD=BobPassword@123
SHOPKART_CAROL_PASSWORD=CarolPassword@123

BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api

# Optional UI/API failure delay used only for trainer demonstrations.
SHOPKART_API_DELAY_MS=0
